# Public origin users reach this app on (no trailing slash).
PUBLIC_BASE_URL=https://cal.example.org

# --- OpenID Connect ----------------------------------------------------------
# Any provider with a discovery document works. Shown here with kanidm; for
# others use whatever URL serves /.well-known/openid-configuration.
OIDC_ISSUER=https://idm.example.org/oauth2/openid/calendar
OIDC_CLIENT_ID=calendar
OIDC_CLIENT_SECRET=change-me
OIDC_SCOPES=openid profile email
# Claim used as the username. Try `email` or `sub` if your provider omits it.
OIDC_USERNAME_CLAIM=preferred_username
# Label on the sign-in button.
OIDC_PROVIDER_NAME=kanidm

# --- sessions ----------------------------------------------------------------
# Generate with: python -c 'import secrets; print(secrets.token_urlsafe(48))'
# The app refuses to start while this is the placeholder or shorter than 32
# characters: session cookies are signed with it, so anyone who knows it can
# forge a session for any user.
SESSION_SECRET=change-me
# Set to false only when testing over plain HTTP on localhost.
COOKIE_SECURE=true

# --- branding ----------------------------------------------------------------
# Shown in the header, browser tab and on the sign-in page.
SITE_TITLE=Community Calendar
# Blurb under the heading on the sign-in page. Leave empty to omit it.
SITE_TAGLINE=A shared calendar for the community, readable in your browser and subscribable from any CalDAV client.
# Separate from SITE_TITLE: this is the calendar name CalDAV clients display.
SHARED_DISPLAY_NAME=Community Calendar

# --- display -----------------------------------------------------------------
DISPLAY_TIMEZONE=America/Los_Angeles
